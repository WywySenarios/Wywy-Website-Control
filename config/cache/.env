# Create sync_status table
SYNC_STATUS=true

# START - Sync app
# Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
SYNC_LOG_LEVEL=INFO
CACHE_LOG_LEVEL=WARNING
SYNC_LOG_LEVEL=WARNING

# The port to run the Django server on.
SYNC_PORT=8000

# END - Sync app

# The port of the Postgres database.
DATABASE_PORT=5433

# Postgres password. You should change it to a random password.
# Please only use alphanumerical (a-Z, 0-9) characters; no special characters, no spaces.

DATABASE_PASSWORD=password

# The values below this line do not need to be changed.
###################################################################################
SYNC_HOST=sync
DATABASE_HOST=database
DATABASE_USERNAME=postgres
USER_ID=25232