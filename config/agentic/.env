# Agentic-specific container user settings
USER_ID=25230
CONTAINER_UID=25233
CONTAINER_GID=2523
OPENCODE_HOST_BINARY_PATH=/home/debian/.nvm/versions/node/v24.16.0/bin/opencode

# Agent settings
AGENT_IMAGE=wywy/agent
AGENT_CONTAINER_UID=25233
AGENT_CONTAINER_GID=2523

# Pipeline settings
PIPELINE_TIMEOUT_SECONDS=600
PIPELINE_MAX_RETRIES=3
PIPELINE_MAX_ITERATIONS=5
PIPELINE_RETRY_BACKOFF_SECONDS=30,60,120

# OpenCode LLM provider API keys (passed to agent container as env vars)
AGENT_DEEPSEEK_API_KEY=
AGENT_OPENAI_API_KEY=
AGENT_ANTHROPIC_API_KEY=
AGENT_OPENCODE_API_KEY=

# The values below this line do not need to be changed.
###################################################################################
# Django / orchestrator
DJANGO_DEBUG=false
DJANGO_DATABASE_PATH=/var/lib/Wywy-Website/orchestrator/db.sqlite3

# Secrets
GITHUB_TOKEN_FILE=/run/secrets/github-pat
