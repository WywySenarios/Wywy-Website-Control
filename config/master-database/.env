# SQL receptionist verbosity
# TRUE/FALSE
SQL_RECEPTIONIST_LOG_QUERIES=TRUE
SQL_RECEPTIONIST_LOG_INPUT=TRUE
SQL_RECEPTIONIST_LOG_ENDPOINT_TRIGGERS=TRUE
SQL_RECEPTIONIST_LOG_SCHEMA_FAILURES=FALSE
SQL_RECEPTIONIST_LOG_REQUESTS=FALSE
SQL_RECEPTIONIST_LOG_RESPONSES=FALSE
SQL_RECEPTIONIST_SEARCH_LIMIT=10

# The port of the Postgres database.
DATABASE_PORT=5432

# Deprecated: Postgres superuser password. NOT version-controlled in plaintext.
# For K8s: encrypted in secrets/prod/postgres-password.sops, bootstrapped
#          as K8s Secret postgres-password via init-k8s-secrets.sh.
# For local Docker Compose: set this to your local dev password.
# DATABASE_PASSWORD=<your-local-dev-password>

# The values below this line do not need to be changed.
###################################################################################
SQL_RECEPTIONIST_HOST=sql_receptionist
DATABASE_HOST=postgres
DATABASE_USERNAME=postgres
USER_ID=25231