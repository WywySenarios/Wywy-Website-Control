# Copy this to /etc/Wywy-Website-Control/config/.env.network and edit.
AGENTIC_API_HOST=localhost
AGENTIC_API_PORT=2524
AGENTIC_WEBSITE_HOST=localhost
AGENTIC_WEBSITE_PORT=2525
AGENTIC_WEBSITE_DEV_PORT=3000

PUBLIC_AGENTIC_API_HOST=localhost
PUBLIC_AGENTIC_API_PORT=2524

# Allowed hosts for agentic dev server (comma-separated).
ALLOWED_HOSTS=localhost

# --- Network defaults ---
GATEWAY=192.168.2.1
NAMESERVER=192.168.2.1

# --- K8s worker IPs (comma-separated) ---
# We assume a bridge network where each worker's index in the list corresponds to the index of the proxmox host.
# We do not guard against mismatching array lengths and will silently ignore the rest of the proxmox hosts when doing something that relies on worker IPs.
# Control plane address (empty = run kubeadm on this machine)
CONTROL_PLANE_IP=
# Dev cluster workers
DEV_K8S_WORKER_IPS=
# Dev Proxmox hypervisor hosts
DEV_PROXMOX_IPS=
# Production cluster workers
K8S_WORKER_IPS=
# Proxmox hypervisor hosts
PROXMOX_IPS=

# The values below this line do not need to be changed.
###################################################################################
# docker hostname
AGENTIC_API_DOCKER_HOST=django
CI_PORT=2526

# CI (Wywy-CI)
PUBLIC_CI_API_HOST=localhost
PUBLIC_CI_API_PORT=2526

# Database VM (dedicated Proxmox VM, not K8s)
# Password in secrets/postgres-password.sops, bootstrap via scripts/init-k8s-secrets.sh
DATABASE_VM_TEMPLATE_VMID=
DATABASE_VM_PROXMOX_HOST=
DATABASE_VM_IP=
DATABASE_VM_POD_CIDR=

# Docker Registry
# Password in secrets/registry-auth.sops, bootstrap via scripts/init-k8s-secrets.sh
CI_REGISTRY_HOST=docker-registry.github-runner
CI_REGISTRY_PORT=5000
CI_REGISTRY_USER=admin