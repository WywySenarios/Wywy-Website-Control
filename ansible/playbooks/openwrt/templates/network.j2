
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '{{ openwrt_dhcp_default_duid }}'
	option ula_prefix '{{ openwrt_ula_prefix }}'

config device 'br_lan'
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'

config device 'sdn_vlan'
	option name 'br-lan.{{ proxmox_sdn_vlan_id }}'
	option type '8021q'
	option ifname 'br-lan'
	option vid '{{ proxmox_sdn_vlan_id }}'

config interface 'sdn'
	option device 'br-lan.{{ proxmox_sdn_vlan_id }}'
	option proto 'static'
	list ipaddr '{{ proxmox_sdn_gateway }}/{{ proxmox_sdn_subnet.split('/')[1] }}'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.235.1/24'
	option ip6assign '60'

config interface 'wan'
	option device 'wan'
	option proto 'dhcp'

config interface 'wan6'
	option device 'wan'
	option proto 'dhcpv6'

