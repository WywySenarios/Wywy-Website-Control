[Unit]
Description=Jellyfin port-forward (kubectl)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=%h
Environment=KUBECONFIG=%h/.kube/config
ExecStart=/usr/bin/kubectl -n jellyfin port-forward svc/jellyfin 8082:8096
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
