[Unit]
Description=Immich UI port-forward (kubectl)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=%h
Environment=KUBECONFIG=%h/.kube/config
ExecStart=/usr/bin/kubectl -n immich port-forward svc/immich-server 8085:2283
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
