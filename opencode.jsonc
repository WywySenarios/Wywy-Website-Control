{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["/etc/Wywy-Website-Control/AGENTS.shared.md"],
  "permission": {
    "external_directory": {
      "/etc/Wywy-Website-Control/**": "allow",
      "/usr/local/Wywy-Website/**": "allow",
      "/var/log/Wywy-Website/**": "allow",
      "/var/lib/Wywy-Website/**": "allow",
      "/var/workspace/Wywy-Website/**": "allow"
    }
  },
  "mcp": {
    "wywy-docs": {
      "type": "remote",
      // PORT env var can override this port (default: 2530)
      "url": "http://127.0.0.1:2530/sse",
      "description": "Wywy-Docs RAG — search documentation"
    }
  }
}
