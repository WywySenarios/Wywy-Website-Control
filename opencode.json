{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": ["/etc/Wywy-Website-Control/AGENTS.shared.md", "AGENTS.md"],
  "permission": {
    "external_directory": {
      "*": "deny",
      "/tmp/opencode": "allow",
      "/etc/Wywy-Website-Control/**": "allow",
      "/usr/local/Wywy-Website/**": "allow",
      "/var/log/Wywy-Website": "allow",
      "/var/lib/Wywy-Website": "allow",
      "/var/workspace/Wywy-Website": "allow"
    }
  }
}
